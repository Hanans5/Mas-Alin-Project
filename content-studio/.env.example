# Copy this file to .env and fill it in. Never commit .env.

# Claude API key from https://console.anthropic.com (empty = demo mode)
ANTHROPIC_API_KEY=

# Port of the dashboard: http://127.0.0.1:8095
PORT=8095

# 127.0.0.1 = only this PC can open it.
# To approve from a phone on the shop wifi: HOST=0.0.0.0 and set API_TOKEN.
HOST=127.0.0.1
API_TOKEN=

# Models (defaults shown)
MODEL_MAIN=claude-sonnet-5-5
MODEL_CHECK=claude-haiku-5-5

# Optional: send events (post.ready_for_review, post.published, ...) to n8n or another tool
WEBHOOK_URL=
