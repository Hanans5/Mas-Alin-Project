# /etc/systemd/system/nelin-batik.service — PocketBase for Nelin Batik.
# Listens on 127.0.0.1 only; nginx is the one public door.
[Unit]
Description=Nelin Batik POS (PocketBase)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hanan
Group=hanan
WorkingDirectory=/home/hanan/nelin-batik
ExecStart=/home/hanan/nelin-batik/pocketbase serve --http=127.0.0.1:8090
Restart=always
RestartSec=3
StartLimitIntervalSec=120
StartLimitBurst=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nelin-batik

# PocketBase writes only to pb_data/.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/hanan/nelin-batik/pb_data
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
